{
  "name": "khanne-log",
  "version": "0.1.0",
  "type": "module",
  "dependencies": {
    "@notionhq/client": "^3.1.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "clsx": "^2.1.1",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-icons": "^5.7.0",
    "react-markdown": "^10.1.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "valibot": "^1.5.0"
  },
  "scripts": {
    "analyze": "ANALYZE=true pnpm build",
    "deploy-prod": "npx vercel link --yes -p khanne-log && npx vercel pull && npx vercel build --prod && npx vercel deploy --prebuilt --prod",
    "dev": "NEXT_PRIVATE_DEBUG_CACHE=1 next dev",
    "build": "next build",
    "lint": "IS_COMMIT_CHECK=true eslint . --cache",
    "lint:analyze": "TIMING=1 IS_COMMIT_CHECK=true eslint .",
    "typegen": "next typegen",
    "lint:inspect": "pnpm dlx @eslint/config-inspector@latest",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@cspell/eslint-plugin": "^10.3.2",
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^9.39.5",
    "@next/eslint-plugin-next": "16.3.5",
    "@testing-library/react": "^16.3.3",
    "@types/node": "24.13.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.2.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.28.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-sort-keys-fix": "^1.1.2",
    "eslint-plugin-unicorn": "^65.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.5.1",
    "prettier": "3.9.6",
    "prettier-plugin-sort-json": "^4.2.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "8.3.0",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": "24.x"
  },
  "lint-staged": {
    "src/**/*.{js,jsx,ts,tsx}": [
      "pnpm lint",
      "bash -c tsc --noEmit --pretty"
    ]
  },
  "packageManager": "pnpm@10.34.5"
}
